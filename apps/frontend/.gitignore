# Frontend-specific ignores (global patterns live in the root .gitignore).

# Vite
dist
dist-ssr
*.local

# IDE: workspace editor settings shared from the root .vscode
.vscode/*

# Tooling caches
*.tsbuildinfo
.eslintcache

# Test artifacts
coverage
/cypress/videos/
/cypress/screenshots/
__screenshots__/

# Compatibility (npm/yarn legacy debug logs are covered by the root rule)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated by Vite dev-tools
*.timestamp-*-*.mjs