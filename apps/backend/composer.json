{
    "name": "vistynq/backend",
    "description": "Minimal PHP backend application",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.79"
    },
    "autoload": {
        "psr-4": {
            "Vistynq\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": "php-cs-fixer check --diff",
        "lint:fix": "php-cs-fixer fix"
    }
}