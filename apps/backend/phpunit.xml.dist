<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         failOnRisky="false"
         failOnWarning="false"
         stopOnFailure="false"
         stopOnError="false">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="test"/>
        <env name="JWT_SECRET" value="test-secret-key-that-is-long-enough-for-hs256-ci"/>
        <env name="ACCESS_TTL" value="900"/>
        <env name="REFRESH_TTL" value="2592000"/>
        <!-- Интеграционные тесты обязаны использовать отдельный test-postgres
             (docker-compose, порт 5433): фикстуры и refresh-токены не должны
             попадать в dev-БД сайта. Значения окружения, заданные снаружи,
             имеют приоритет над этими дефолтами (EnvLoader их не перезапишет). -->
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_NAME" value="vistynq_test"/>
        <env name="DB_USER" value="vistynq"/>
        <env name="DB_PASS" value="vistynq_test_password"/>
        <!-- verify-email ходит письмом в Mailpit (см. tests/Integration/AuthFlowTest) -->
        <env name="SMTP_HOST" value="127.0.0.1"/>
        <env name="SMTP_PORT" value="1025"/>
        <!-- R17: интеграционные тесты работают с реальным MinIO; отдельный
             бакет, чтобы не трогать dev-объекты. -->
        <env name="STORAGE_DRIVER" value="s3"/>
        <env name="S3_ENDPOINT" value="http://127.0.0.1:9000"/>
        <env name="S3_PUBLIC_ENDPOINT" value="http://127.0.0.1:9000"/>
        <env name="S3_BUCKET" value="vistynq-test"/>
        <env name="S3_USE_PATH_STYLE" value="true"/>
    </php>
</phpunit>
