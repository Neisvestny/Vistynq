#!/bin/sh
set -e

cd "$(dirname "$0")/.."

PHP_ARGS=""
if ! php -r 'exit(in_array("pgsql", PDO::getAvailableDrivers(), true) ? 0 : 1);' 2>/dev/null; then
  PHP_ARGS="-d extension=pdo_pgsql"
fi

# public/index.php doubles as the router script so every path hits the front controller.
exec php $PHP_ARGS -S "127.0.0.1:${1:-8000}" -t public public/index.php
