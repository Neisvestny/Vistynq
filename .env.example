# Скопируйте в `.env` и смените секреты перед работой: cp .env.example .env
# Это единственный env, который реально читает docker compose (интерполяция).
# Контракт переменных бэкенда (полный список) — в apps/backend/.env.example.

POSTGRES_DB=vistynq
POSTGRES_USER=vistynq
POSTGRES_PASSWORD=vistynq_dev_password

MINIO_ROOT_USER=vistynq-minio
MINIO_ROOT_PASSWORD=minio_dev_password

S3_BUCKET=vistynq-media
S3_REGION=us-east-1

JWT_SECRET=dev_only_change_me

APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
MAIL_FROM=no-reply@vistynq.local

# Mailpit перехватывает всё без авторизации — в dev пусто
SMTP_USER=
SMTP_PASS=

# Пусто = cookie выдаётся на текущий домен; Secure только за HTTPS
COOKIE_DOMAIN=
COOKIE_SECURE=false
